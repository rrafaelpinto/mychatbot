# Development defaults are intentionally safe and contain no real credentials.
RESUMEBOT_ENV=development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=resumebot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=true
AI_CANDIDATE_CHAT_ENABLED=true
AI_CHAT_IDENTITY_PER_MINUTE=5
AI_CHAT_IDENTITY_PER_DAY=100
AI_CHAT_CANDIDATE_PER_DAY=500
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=100
AI_INPUT_USD_PER_MILLION=0.15
AI_OUTPUT_USD_PER_MILLION=0.60

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# Guest chat remains disabled until real Turnstile credentials are configured.
GUEST_CHAT_ENABLED=false
GUEST_CLEANUP_SCHEDULED=false
GUEST_TURNSTILE_SITE_KEY=
GUEST_TURNSTILE_SECRET_KEY=
GUEST_IP_HASH_SECRET=
# Comma-separated proxy IPs which overwrite X-Forwarded-For.
GUEST_TRUSTED_PROXY_IPS=
AI_MAX_INPUT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=500

# Explicit opt-in required: sends private resume text to the AI provider.
AI_KNOWLEDGE_EXTRACTION_ENABLED=false

# Production defaults: no public account registration or file uploads.
PUBLIC_REGISTRATION_ENABLED=false
CANDIDATE_UPLOADS_ENABLED=false
# Required only when uploads are deliberately enabled in production.
PUBLIC_MEDIA_ROOT=
PRIVATE_MEDIA_ROOT=
# Use Render's internal Postgres connection URL instead of POSTGRES_* if provided.
DATABASE_URL=
# Enable proxy protocol trust only behind a proxy that overwrites the header.
DJANGO_TRUST_X_FORWARDED_PROTO=false
# Keep paid AI and real-model evaluation disabled until explicitly approved.
AI_EVALUATION_PAID_ENABLED=false
AI_SEMANTIC_INDEX_ENABLED=false
AI_SEMANTIC_QUERY_ENABLED=false
